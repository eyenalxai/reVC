+/* True if the two matrices hold the same 12 floats. Used to tell whether a
+ * hierarchy root's matrix was really written since the last sync. */
+static bool
+matrixEquals(const Matrix *a, const Matrix *b)
+{
+	return a->right.x == b->right.x && a->right.y == b->right.y &&
+	       a->right.z == b->right.z &&
+	       a->up.x == b->up.x && a->up.y == b->up.y && a->up.z == b->up.z &&
+	       a->at.x == b->at.x && a->at.y == b->at.y && a->at.z == b->at.z &&
+	       a->pos.x == b->pos.x && a->pos.y == b->pos.y && a->pos.z == b->pos.z;
+}
+
 /* Synch just LTM matrices in a hierarchy */
 static void
 syncLTMRecurse(Frame *frame, uint8 hierarchyFlags)
@@ -205,17 +217,34 @@ static void
 syncRecurse(Frame *frame, uint8 hierarchyFlags)
 {
 	for(; frame; frame = frame->next){
-		// If frame is dirty or any parent was dirty, update LTM
-		hierarchyFlags |= frame->object.privateFlags;
-		if(hierarchyFlags & Frame::SUBTREESYNCLTM)
+		uint8 flags = frame->object.privateFlags;
+		bool ancestorChanged = (hierarchyFlags & Frame::SUBTREESYNCLTM) != 0;
+		// The frame was written since the last sync. When an ancestor already
+		// changed, this frame's LTM has to be recomputed anyway, so the flag can
+		// stay set until a sync where it matters.
+		bool matrixChanged = false;
+		if(!ancestorChanged){
+			matrixChanged = (frame->matrix.flags & Matrix::CHANGED) != 0;
+			frame->matrix.flags &= ~Matrix::CHANGED;
+		}
+		// The LTM only has to be recomputed if the frame's own matrix was
+		// written or if the parent's LTM changed. A mark on the frame still
+		// forces the recompute.
+		bool needLTM = ancestorChanged ||
+		               (flags & Frame::SUBTREESYNCLTM) != 0 ||
+		               matrixChanged;
+		// Objects depend on the LTM, so they only have to be synched when the
+		// LTM changed or the frame itself has unsynched objects.
+		bool needObj = needLTM || (flags & Frame::SUBTREESYNCOBJ) != 0;
+		if(needLTM)
 			Matrix::mult(&frame->ltm, &frame->matrix,
 			             &frame->getParent()->ltm);
-		// Synch attached objects
-		FORLIST(lnk, frame->objectList)
-			ObjectWithFrame::fromFrame(lnk)->sync();
+		if(needObj)
+			FORLIST(lnk, frame->objectList)
+				ObjectWithFrame::fromFrame(lnk)->sync();
 		frame->object.privateFlags &= ~Frame::SUBTREESYNC;
-		// And synch all children
-		syncRecurse(frame->child, hierarchyFlags);
+		// Only a new LTM forces the children's LTMs to be recomputed
+		syncRecurse(frame->child, needLTM ? (uint8)Frame::SUBTREESYNCLTM : 0);
 	}
 }
 
